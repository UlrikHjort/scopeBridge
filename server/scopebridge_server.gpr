--  Built by `make server`, or: gprbuild -p -P server/scopebridge_server.gpr
--  Copyright (C) 2026 By Ulrik Hørlyk Hjort; MIT licence, see LICENSE.

with "gnatcoll";
with "../rigol_lib.gpr";

project Scopebridge_Server is

   for Source_Dirs use ("src", "tests");
   for Object_Dir  use "../obj/server";
   for Exec_Dir    use "../bin";
   for Main        use ("scopebridge_server.adb", "test_spectrum.adb", "test_decode.adb",
                        "test_timing.adb");

   --  Ada names cannot have hyphens; the command can
   package Builder is
      for Executable ("scopebridge_server.adb") use "scopebridge-server";
   end Builder;

   package Compiler is
      --  -O2: the server's FFT is about three times faster with it
      for Default_Switches ("Ada") use ("-gnatwa", "-gnato", "-gnat2012", "-O2");
   end Compiler;

end Scopebridge_Server;
