--  scopebridge-gui: GtkAda front end for scopebridge-server (docs/PROTOCOL.md).
--  Built by `make gui`, or: gprbuild -p -P gui/scopebridge_gui.gpr
--  Copyright (C) 2026 By Ulrik Hørlyk Hjort; MIT licence, see LICENSE.

with "gtkada";
with "gnatcoll";

project Scopebridge_Gui is

   --  Server.Wire (message framing) is shared with the server
   for Source_Dirs use ("src", "../server/src");
   for Excluded_Source_Files use
     ("scopebridge_server.adb", "server-session.ads", "server-session.adb",
      "server-spectrum.ads", "server-spectrum.adb", "server-decode.ads",
      "server-decode.adb");
   for Object_Dir  use "../obj/gui";
   for Exec_Dir    use "../bin";
   for Main        use ("scopebridge_gui.adb");

   --  Ada names cannot have hyphens; the command can
   package Builder is
      for Executable ("scopebridge_gui.adb") use "scopebridge-gui";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnato", "-gnat2012");
   end Compiler;

end Scopebridge_Gui;
