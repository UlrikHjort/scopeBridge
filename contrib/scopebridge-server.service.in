# scopebridge-server as a systemd user service, installed by "make install".
# The server takes its settings from ~/.scopebridgerc ([server]): the
# scope's source, the port, the address it listens on, the web interface.
# Without them, it looks for the scope on USB.
#
#   systemctl --user enable --now scopebridge-server
#
# Options can also be given in ~/.config/scopebridge/server.conf, and win
# over ~/.scopebridgerc:
#   SCOPEBRIDGE_SERVER_ARGS=--lan 192.168.0.83
#          (your scope's address in place of the example 192.168.0.83)
# Copyright (C) 2026 By Ulrik Hørlyk Hjort; MIT licence, see LICENSE.

[Unit]
Description=ScopeBridge oscilloscope server (scopebridge-server)
Documentation=man:scopebridge-server(1)

[Service]
EnvironmentFile=-%h/.config/scopebridge/server.conf
ExecStart=@BINDIR@/scopebridge-server $SCOPEBRIDGE_SERVER_ARGS
# The scope may be off or not yet on the network: try again
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
